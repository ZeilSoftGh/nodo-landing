---
// Internal visual-standard specimen, preserved from the pre-Fase-01 home
// (§9). Kept as a living style reference and served at /styleguide with
// noindex; the public home is the Fase 01 experience compositor.
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="NODO — Estándar visual"
  description="Base visual de NODO: noche, barra, mesa y encuentro."
  noindex
>
  <div class="specimen">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="NODO, volver al inicio">
        <span class="brand-seal" aria-hidden="true"><span></span></span>
        <span class="wordmark__text">NODO</span>
      </a>
      <p class="site-header__meta">
        <span>Estándar visual</span>
        <span>01 / 04</span>
      </p>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__wash" aria-hidden="true"></div>
      <div class="hero__clock" aria-hidden="true">
        <span class="hero__clock-hand hero__clock-hand--hour"></span>
        <span class="hero__clock-hand hero__clock-hand--minute"></span>
        <span class="hero__clock-center"></span>
      </div>
      <div class="hero__poster" aria-hidden="true">
        <svg class="hero__poster-lineart" viewBox="0 0 240 180" role="presentation">
          <path d="M43 35h65l-6 54c-2 17-15 28-29 28S46 106 45 89l-2-54Z"></path>
          <path d="M58 37c8 14 24 19 45 15"></path>
          <path d="M82 117v29M64 146h40"></path>
          <path d="M132 48h55l-5 42c-2 15-13 24-26 24s-23-9-24-24l-1-42Z"></path>
          <path d="M145 49c8 12 21 17 39 14"></path>
          <path d="M157 114v32M140 146h37"></path>
          <path d="M30 75c18-1 31 6 42 18M184 69c13 4 22 12 29 23"></path>
        </svg>
        <span class="hero__poster-title">Entre copas</span>
        <span class="hero__poster-copy">Una nueva experiencia de NODO.</span>
        <span class="hero__poster-mark">✦</span>
      </div>
      <div class="hero__copy">
        <p class="eyebrow">Bar / San Miguel del Monte</p>
        <h1 id="hero-title">Donde la barra <em>encuentra</em> la noche.</h1>
        <p class="hero__lede">
          Un sistema oscuro, cálido y cercano para mostrar lo que pasa alrededor de la carta: una
          mesa, un cóctel, música y personas.
        </p>
        <div class="hero__actions" aria-label="Acciones de muestra">
          <a class="button button--primary" href="#principles">Ver el lenguaje</a>
          <a class="text-link" href="#palette">Explorar tokens <span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <div class="hero__footer">
        <span>Jue · Vie · Sáb / 20:30</span>
        <span>Hipólito Yrigoyen 450</span>
        <span>Puerta azul · Frente a la plaza</span>
      </div>
    </section>

    <section class="principles" id="principles" aria-labelledby="principles-title">
      <div class="section-heading">
        <p class="eyebrow">02 / Posicionamiento</p>
        <h2 id="principles-title">NODO es lo que sucede alrededor de la copa.</h2>
      </div>
      <div class="principles__grid">
        <article class="principle">
          <span class="principle__index">01</span>
          <h3>La barra propone.</h3>
          <p>Clásicos, autor y atención al detalle. El cóctel como punto de partida.</p>
        </article>
        <article class="principle">
          <span class="principle__index">02</span>
          <h3>La cocina acompaña.</h3>
          <p>Platos para compartir, descubrir sabores y pedir otro trago.</p>
        </article>
        <article class="principle">
          <span class="principle__index">03</span>
          <h3>El ambiente recibe.</h3>
          <p>Una noche con su propio ritmo: música, mesa, encuentro y memoria.</p>
        </article>
      </div>
    </section>

    <section class="cocktail-section" aria-labelledby="cocktail-title">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">03 / Producto</p>
          <h2 id="cocktail-title">El cóctel ocupa la escena.</h2>
        </div>
        <p class="section-heading__note">Fotografía cercana · fondo profundo · título dorado</p>
      </div>

      <article class="cocktail-card">
        <div class="cocktail-card__texture" aria-hidden="true"></div>
        <div class="cocktail-glass" aria-hidden="true"><span></span></div>
        <div class="cocktail-card__copy">
          <p class="eyebrow">01 / La barra</p>
          <h3>Negroni</h3>
          <p class="cocktail-card__notes">Intenso · amargo · dulce</p>
          <p class="cocktail-card__description">
            Un clásico que encontró su lugar en NODO. Una mezcla de contrastes que se queda en el
            paladar.
          </p>
        </div>
        <span class="cocktail-card__vertical">Atención al detalle</span>
        <span class="cocktail-card__mark" aria-hidden="true">✦</span>
      </article>
    </section>

    <section class="palette-section" id="palette" aria-labelledby="palette-title">
      <div class="section-heading">
        <p class="eyebrow">04 / Paleta</p>
        <h2 id="palette-title">Oscuridad con temperatura.</h2>
      </div>
      <div class="palette-grid">
        <div class="swatch swatch--night"><span>#071311</span><small>NODO NIGHT</small></div>
        <div class="swatch swatch--deep"><span>#0D3F37</span><small>DEEP GREEN</small></div>
        <div class="swatch swatch--teal"><span>#056454</span><small>NODO TEAL</small></div>
        <div class="swatch swatch--gold"><span>#C9A743</span><small>AGED GOLD</small></div>
        <div class="swatch swatch--cream"><span>#EFE8D0</span><small>WARM CREAM</small></div>
        <div class="swatch swatch--copper"><span>#D47727</span><small>COCKTAIL LIGHT</small></div>
      </div>
    </section>

    <section class="festa-panel" aria-labelledby="festa-title">
      <div class="festa-panel__rings" aria-hidden="true"></div>
      <div class="festa-panel__copy">
        <p class="eyebrow">Modo evento / sub-brand</p>
        <h2 id="festa-title">NODO<span>FESTA</span></h2>
        <p>
          La misma noche, otra frecuencia: cromo, CD, neón y energía 90/2000. Un acento de evento,
          no el canvas cotidiano del bar.
        </p>
        <a class="button button--festa" href="#hero-title">Volver a NODO</a>
      </div>
      <div class="festa-panel__signal" aria-hidden="true">90 / 2000</div>
    </section>

    <footer class="site-footer">
      <span>NODO / Cóctel Bar</span>
      <span>Un punto de encuentro</span>
      <span>Estándar v0.1</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .specimen {
    width: min(100%, var(--layout-max));
    margin-inline: auto;
    padding: 0 clamp(1rem, 4vw, 4rem) 4rem;
  }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-header {
    padding-block: 1.5rem 2rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .wordmark__text {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.16em;
  }

  .brand-seal {
    position: relative;
    display: grid;
    width: 2.25rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-brand);
    box-shadow: inset 0 0 0 0.25rem rgb(7 19 17 / 42%);
  }

  .brand-seal::before,
  .brand-seal::after,
  .brand-seal span::before,
  .brand-seal span::after {
    position: absolute;
    display: block;
    width: 1.3rem;
    height: 1px;
    background: var(--color-accent);
    content: '';
  }

  .brand-seal::before {
    transform: rotate(0deg);
  }

  .brand-seal::after {
    transform: rotate(90deg);
  }

  .brand-seal span::before {
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: 50%;
    background: var(--color-brand);
  }

  .brand-seal span::after {
    width: 0.2rem;
    height: 0.2rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
  }

  .site-header__meta {
    display: flex;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: min(48rem, calc(100svh - 7rem));
    overflow: hidden;
    border: 1px solid var(--color-border);
    background:
      linear-gradient(115deg, rgb(7 19 17 / 94%) 8%, rgb(7 19 17 / 58%) 54%, rgb(5 100 84 / 24%)),
      radial-gradient(circle at 72% 22%, rgb(201 167 67 / 15%), transparent 20rem), var(--color-bg);
    box-shadow: var(--shadow-deep);
  }

  .hero::after {
    position: absolute;
    z-index: -1;
    right: -15%;
    bottom: -45%;
    width: 70%;
    aspect-ratio: 1;
    border: 1px solid rgb(201 167 67 / 20%);
    border-radius: 50%;
    box-shadow:
      0 0 0 2rem rgb(201 167 67 / 5%),
      0 0 0 4rem rgb(201 167 67 / 4%),
      0 0 0 8rem rgb(201 167 67 / 3%);
    content: '';
  }

  .hero__wash {
    position: absolute;
    z-index: -2;
    inset: 0;
    opacity: 0.5;
    background:
      repeating-radial-gradient(
        circle at 76% 32%,
        transparent 0 1.4rem,
        rgb(201 167 67 / 14%) 1.45rem 1.5rem,
        transparent 1.55rem 3rem
      ),
      linear-gradient(160deg, transparent 35%, rgb(5 100 84 / 26%) 80%);
    mask-image: linear-gradient(135deg, transparent 10%, #000 45%, transparent 95%);
  }

  .hero__clock {
    position: absolute;
    right: 10%;
    bottom: 12%;
    width: clamp(15rem, 38vw, 30rem);
    aspect-ratio: 1;
    border: 1px solid rgb(201 167 67 / 30%);
    border-radius: 50%;
    opacity: 0.75;
  }

  .hero__poster {
    position: absolute;
    z-index: 1;
    top: 15%;
    right: clamp(4%, 9vw, 10%);
    display: grid;
    width: clamp(17rem, 31vw, 27rem);
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border: 2px solid rgb(239 232 208 / 82%);
    border-radius: 49% 51% 47% 53% / 52% 46% 54% 48%;
    outline: 1px solid rgb(239 232 208 / 20%);
    outline-offset: 0.6rem;
    background:
      linear-gradient(160deg, rgb(5 100 84 / 70%), rgb(7 19 17 / 68%)),
      radial-gradient(circle at 70% 74%, rgb(212 119 39 / 28%), transparent 45%), var(--color-brand);
    box-shadow:
      inset 0 0 3rem rgb(7 19 17 / 38%),
      0 0 3rem rgb(5 100 84 / 20%);
    transform: rotate(-4deg);
  }

  .hero__poster::before {
    position: absolute;
    inset: 1.2rem;
    border: 1px solid rgb(239 232 208 / 22%);
    border-radius: 51% 49% 54% 46% / 48% 52% 47% 53%;
    content: '';
  }

  .hero__poster::after {
    position: absolute;
    inset: -15%;
    background:
      radial-gradient(ellipse at 23% 74%, rgb(239 232 208 / 15%) 0 4%, transparent 4.5%),
      radial-gradient(ellipse at 80% 22%, rgb(239 232 208 / 12%) 0 5%, transparent 5.5%),
      linear-gradient(
        135deg,
        transparent 30%,
        rgb(201 167 67 / 10%) 31% 34%,
        transparent 35% 65%,
        rgb(201 167 67 / 8%) 66% 68%,
        transparent 69%
      );
    opacity: 0.7;
  }

  .hero__poster-lineart {
    position: absolute;
    z-index: 1;
    top: 16%;
    width: 67%;
    overflow: visible;
    color: var(--color-accent);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }

  .hero__poster-title,
  .hero__poster-copy,
  .hero__poster-mark {
    position: relative;
    z-index: 2;
  }

  .hero__poster-title {
    margin-top: 7rem;
    color: var(--color-accent-strong);
    font-family: 'Brush Script MT', 'Segoe Script', cursive;
    font-size: clamp(1.7rem, 3.8vw, 3.4rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }

  .hero__poster-copy {
    margin-top: 12rem;
    color: var(--nodo-gold-soft);
    font-family: var(--font-display);
    font-size: clamp(0.65rem, 1vw, 0.85rem);
    letter-spacing: 0.03em;
  }

  .hero__poster-mark {
    position: absolute;
    bottom: 13%;
    color: var(--color-accent);
    font-size: 1rem;
  }

  .hero__clock::before,
  .hero__clock::after {
    position: absolute;
    inset: 9%;
    border: 1px solid rgb(201 167 67 / 20%);
    border-radius: 50%;
    content: '';
  }

  .hero__clock::after {
    inset: 24%;
    border-color: rgb(5 100 84 / 80%);
    background: radial-gradient(circle, rgb(201 167 67 / 15%), transparent 62%);
  }

  .hero__clock-hand {
    position: absolute;
    bottom: 50%;
    left: 50%;
    transform-origin: 50% 100%;
    background: var(--color-accent);
  }

  .hero__clock-hand--hour {
    width: 1px;
    height: 26%;
    transform: rotate(28deg);
  }

  .hero__clock-hand--minute {
    width: 1px;
    height: 37%;
    transform: rotate(134deg);
    opacity: 0.65;
  }

  .hero__clock-center {
    position: absolute;
    top: calc(50% - 0.25rem);
    left: calc(50% - 0.25rem);
    width: 0.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-accent-strong);
    border-radius: 50%;
    background: var(--color-brand);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(100%, 44rem);
    flex-direction: column;
    justify-content: center;
    padding: clamp(5rem, 11vw, 9rem) clamp(1.5rem, 6vw, 6rem) 7rem;
  }

  .hero h1 {
    max-width: 10ch;
    margin-top: 1.5rem;
    color: var(--color-text);
    font-size: clamp(3.6rem, 8.5vw, 8.4rem);
    line-height: 0.86;
  }

  .hero h1 em {
    color: var(--color-accent-strong);
    font-style: italic;
  }

  .hero__lede {
    max-width: 31rem;
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.15rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform var(--duration-fast) var(--ease-nodo),
      background-color var(--duration-fast) var(--ease-nodo),
      color var(--duration-fast) var(--ease-nodo);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button--primary {
    background: var(--color-accent);
    color: var(--nodo-ink);
  }

  .button--primary:hover {
    background: var(--color-accent-strong);
  }

  .button--festa {
    border-color: var(--festa-cyan);
    background: transparent;
    color: var(--festa-cyan);
  }

  .button--festa:hover {
    background: var(--festa-cyan);
    color: var(--nodo-ink);
  }

  .text-link {
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .text-link span {
    display: inline-block;
    margin-left: 0.3rem;
    color: var(--color-accent);
    transition: transform var(--duration-fast) var(--ease-nodo);
  }

  .text-link:hover span {
    transform: translate(0.2rem, 0.2rem);
  }

  .hero__footer {
    position: absolute;
    z-index: 2;
    right: clamp(1rem, 4vw, 3rem);
    bottom: 1.5rem;
    left: clamp(1rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.67rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .principles,
  .cocktail-section,
  .palette-section {
    padding-top: clamp(6rem, 12vw, 10rem);
  }

  .section-heading {
    max-width: 48rem;
  }

  .section-heading h2 {
    margin-top: 1rem;
    color: var(--color-text);
    font-size: clamp(2.8rem, 5.5vw, 5.5rem);
    line-height: 0.9;
  }

  .section-heading--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    max-width: none;
  }

  .section-heading__note {
    max-width: 14rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
    text-align: right;
  }

  .principles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 4rem;
    border-block: 1px solid var(--color-border);
  }

  .principle {
    min-height: 16rem;
    padding: 1.5rem 1.25rem 2rem;
    border-inline: 1px solid var(--color-border);
    background: linear-gradient(160deg, rgb(5 100 84 / 9%), transparent 50%);
  }

  .principle + .principle {
    border-inline: 0;
    border-right: 1px solid var(--color-border);
  }

  .principle__index {
    display: block;
    color: var(--color-accent);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
  }

  .principle h3 {
    margin-top: 5rem;
    color: var(--color-accent-strong);
    font-size: clamp(1.7rem, 2.5vw, 2.5rem);
    line-height: 0.95;
  }

  .principle p {
    max-width: 18rem;
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .cocktail-card {
    position: relative;
    isolation: isolate;
    min-height: min(42rem, 72svh);
    margin-top: 3rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background:
      linear-gradient(102deg, rgb(7 19 17 / 96%) 10%, rgb(7 19 17 / 50%) 55%, rgb(165 45 37 / 28%)),
      radial-gradient(circle at 80% 70%, rgb(212 119 39 / 44%), transparent 24rem),
      var(--color-surface);
    box-shadow: var(--shadow-deep);
  }

  .cocktail-card__texture {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      repeating-linear-gradient(75deg, transparent 0 1.4rem, rgb(201 167 67 / 4%) 1.45rem 1.5rem),
      radial-gradient(circle at 80% 68%, rgb(201 167 67 / 20%), transparent 1px);
    background-size:
      auto,
      7px 7px;
    opacity: 0.5;
  }

  .cocktail-glass {
    position: absolute;
    right: clamp(6%, 14vw, 18%);
    bottom: -8%;
    width: clamp(10rem, 23vw, 18rem);
    height: clamp(20rem, 48vw, 34rem);
    border: 1px solid rgb(239 232 208 / 48%);
    border-radius: 1rem 1rem 2.75rem 2.75rem;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 2%),
      rgb(255 255 255 / 16%),
      rgb(255 255 255 / 3%)
    );
    box-shadow:
      inset 1rem 0 rgb(239 232 208 / 6%),
      0 0 2rem rgb(201 167 67 / 10%);
    transform: perspective(28rem) rotateY(-16deg) rotateZ(2deg);
  }

  .cocktail-glass::before {
    position: absolute;
    top: 3%;
    right: 7%;
    left: 7%;
    height: 1.2rem;
    border: 1px solid rgb(239 232 208 / 56%);
    border-radius: 50%;
    content: '';
  }

  .cocktail-glass::after {
    position: absolute;
    right: -0.2rem;
    bottom: -6rem;
    left: -0.2rem;
    height: 14rem;
    border-radius: 0 0 2.75rem 2.75rem;
    background: linear-gradient(180deg, rgb(165 45 37 / 25%), rgb(165 45 37 / 82%));
    box-shadow: inset 0 1rem rgb(212 119 39 / 20%);
    content: '';
  }

  .cocktail-glass span {
    position: absolute;
    z-index: 1;
    top: 16%;
    right: 15%;
    width: 1px;
    height: 55%;
    background: linear-gradient(180deg, rgb(239 232 208 / 70%), transparent);
    transform: rotate(8deg);
  }

  .cocktail-card__copy {
    position: relative;
    z-index: 2;
    max-width: 32rem;
    padding: clamp(2rem, 7vw, 6rem);
  }

  .cocktail-card h3 {
    margin-top: 0.85rem;
    color: var(--color-accent-strong);
    font-size: clamp(4rem, 10vw, 9rem);
    line-height: 0.78;
  }

  .cocktail-card__notes {
    margin-top: 1.5rem;
    color: var(--color-copper);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cocktail-card__description {
    max-width: 20rem;
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .cocktail-card__vertical {
    position: absolute;
    top: 2rem;
    right: 2rem;
    color: var(--color-text-muted);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .cocktail-card__mark {
    position: absolute;
    right: 3rem;
    bottom: 2rem;
    color: var(--color-accent);
    font-size: 1.25rem;
  }

  .palette-grid {
    display: grid;
